# Bash secrets template - copy to secrets.sh and fill in your values
# cp secrets.sh.template secrets.sh && chmod 600 secrets.sh
# DO NOT COMMIT secrets.sh (gitignored, like .env)

# Database
export DATABASE_USER_PASSWORD="your_password_here"
export API_ACCESS_KEY="your_api_key_here"

# GitHub
export GITHUB_PERSONAL_ACCESS_TOKEN="ghp_xxxxxxxxxxxx"

# Sentry
export SENTRY_AUTH_TOKEN="sntryu_xxxxxxxxxxxx"

# AI / OpenRouter
export OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxx"
export ANTHROPIC_BASE_URL="https://openrouter.ai/api"
export ANTHROPIC_AUTH_TOKEN="$OPENROUTER_API_KEY"
export ANTHROPIC_API_KEY=""

# Apple Developer
export APPLE_TEAM_ID="YOUR_TEAM_ID"
export APPLE_API_KEY="$HOME/AuthKey_YOURKEY.p8"
export APPLE_API_KEY_ID="YOUR_KEY_ID"
export APPLE_API_ISSUER="your-issuer-uuid"
