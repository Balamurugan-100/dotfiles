{
  "cli_default_open_behavior": "existing_window",
  "session": {
    "trust_all_worktrees": true
  },
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "terminal": {
    "dock": "right"
  },
  "project_panel": {
    "entry_spacing": "comfortable",
    "dock": "left"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "edit_predictions": {
    "provider": "copilot",
    "mode": "subtle"
  },
"agent": {
  "dock": "right",
  "sidebar_side": "right",
  "show_turn_stats": true,
  "single_file_review": true,
  "tool_permissions": {
   "default": "confirm",
   "tools": {}
  },
  "enabled": true,
  "default_model": {
    "provider": "google",
    "model": "gemini-2.5-flash"
  },
  "model_parameters": [],
  "providers": [
    {
      "name": "opencode",
      "type": "acp",
      "command": "opencode",
      "args": ["acp"]
    }
  ]
},
  "preview_tabs": {
    "enabled": false
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme"
  },
  "base_keymap": "VSCode",
  "ui_font_size": 19.0,
  "buffer_font_size": 24.0,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Duskfox - blurred"
  },
  "agent_servers": {
    "antigravity-acp": {
      "default_config_options": {
        "model": "gemini-3.1-pro-low",
        "mode": "yolo"
      },
      "type": "registry"
    },
    "OpenCode": {
      "type": "custom",
      "command": "opencode",
      "args": ["acp"]
    }
  }
}
