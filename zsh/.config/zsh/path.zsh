path=(
  # User
  "$HOME/.local/bin"
  "$HOME/bin"
  "$HOME/.cargo/bin"

  # Homebrew
  "/opt/homebrew/bin"
  "/opt/homebrew/sbin"

  # Python
  "$PYENV_ROOT/bin"

  # Android
  "$ANDROID_HOME/cmdline-tools/latest/bin"
  "$ANDROID_HOME/platform-tools"
  "$ANDROID_HOME/emulator"

  # pnpm
  "$PNPM_HOME"

  # Antigravity
  "$HOME/.antigravity/antigravity/bin"
  "$HOME/.antigravity-ide/antigravity-ide/bin"

  # OpenCode
  "$HOME/.opencode/bin"

  # OrbStack
  "$HOME/.orbstack/bin"

  $path
)
