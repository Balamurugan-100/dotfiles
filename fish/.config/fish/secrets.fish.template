# Fish secrets template - copy to secrets.fish and fill in your values
# cp secrets.fish.template secrets.fish
# DO NOT COMMIT secrets.fish

# Database
set -gx DATABASE_USER_PASSWORD "your_password_here"
set -gx API_ACCESS_KEY "your_api_key_here"

# GitHub
set -gx GITHUB_PERSONAL_ACCESS_TOKEN "ghp_xxxxxxxxxxxx"

# Sentry
set -gx SENTRY_AUTH_TOKEN "sntryu_xxxxxxxxxxxx"

# AI / OpenRouter
set -x OPENROUTER_API_KEY "sk-or-v1-xxxxxxxxxxxx"
set -x ANTHROPIC_BASE_URL "https://openrouter.ai/api"
set -x ANTHROPIC_AUTH_TOKEN $OPENROUTER_API_KEY
set -x ANTHROPIC_API_KEY ""
