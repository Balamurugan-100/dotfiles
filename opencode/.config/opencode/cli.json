{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "mode": "system",
    "name": "opencode"
  },
  "animations": true,
  "session": {
    "sidebar": "hide",
    "scrollbar": true,
    "thinking": "show",
    "markdown": "rendered",
    "grouping": "auto",
    "verbosity": "low",
    "image_preview": true,
    "new_location": "launch",
    "permissions": "prompt"
  },
  "tabs": {
    "mode": "off",
    "layout": "vertical",
    "scope": "cwd",
    "indicators": "status"
  },
  "diffs": {
    "view": "split",
    "single": false
  },
  "scroll": {
    "acceleration": true,
    "speed": 3.75
  },
  "prompt": {
    "image_preview": true,
    "paste": "full"
  },
  "attention": {
    "notifications": true
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": false
  },
  "leader": {
    "timeout": 2250
  }
}
